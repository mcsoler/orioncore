# Copiar y ajustar valores:
#   - DEV (máquina local):  <DEV_APP_DIR>/.dev.env  (p. ej. /Users/msoler/Desktop/orioncore/.dev.env)
#   - Producción:           <APP_DIR>/.env          (p. ej. /home/orion/.env)
# Nunca se sube al repo.

# ── Nginx ────────────────────────────────────────────────────────────────────
# Puertos del host donde escucha Nginx (en el servidor: HTTP_PORT=3000, HTTPS_PORT=3443,
# con el router reenviando 80 → 3000 y 443 → 3443)
HTTP_PORT=80
HTTPS_PORT=443

# ── HTTPS (solo servidor) ────────────────────────────────────────────────────
# http  = sin certificado (DEV, o servidor antes de emitir el certificado)
# https = con certificado de Let's Encrypt para DOMAIN y www.DOMAIN
NGINX_MODE=http
DOMAIN=localhost
# En el servidor, "ssl" levanta el contenedor que renueva el certificado
COMPOSE_PROFILES=

# ── MongoDB ──────────────────────────────────────────────────────────────────
# Solo se aplican al crear el volumen por primera vez.
# Usar solo letras y números en la contraseña (va dentro de la URL de conexión).
# Generar con: openssl rand -hex 24
MONGO_USER=orioncore
MONGO_PASSWORD=cambia-esto-por-una-clave-segura
DATABASE_NAME=orioncore

# ── Autenticación de la API ──────────────────────────────────────────────────
# Firma de los tokens. Mínimo 32 caracteres. Generar con: openssl rand -hex 32
JWT_SECRET=cambia-esto-por-un-secreto-de-al-menos-32-caracteres
JWT_EXPIRE_MINUTES=60

# Credenciales para obtener el token en POST /api/auth/token. Mínimo 12 caracteres.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=cambia-esto-por-una-clave-segura

# ── URLs ─────────────────────────────────────────────────────────────────────
# Vacío = el frontend llama a /api en el mismo dominio y Nginx lo enruta al backend.
# Solo definir si el backend vive en otro dominio.
PUBLIC_API_URL=

# Orígenes permitidos por CORS (separados por coma). Solo importa si PUBLIC_API_URL
# apunta a otro dominio. En el servidor: http://<ip-publica>
CORS_ORIGINS=http://localhost

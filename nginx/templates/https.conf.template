# NGINX_MODE=https — servidor con certificado de Let's Encrypt para ${DOMAIN}.
# La imagen de Nginx reemplaza ${DOMAIN} al arrancar; las variables de Nginx
# ($host, $request_uri...) no se tocan porque no son variables de entorno.

server {
    listen 80;
    server_name _;

    # Renovación de Let's Encrypt
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    # Lo usa el chequeo de salud de deploy.sh por HTTP local, sin redirección
    location = /health {
        access_log off;
        set $backend http://backend:8000;
        proxy_pass $backend;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${DOMAIN} www.${DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    add_header Strict-Transport-Security "max-age=31536000" always;

    include /etc/nginx/snippets/app.conf;
}

{
  "name": "orioncore-frontend",
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "dev": "node scripts/copy-globe-assets.mjs && astro dev",
    "start": "pnpm dev",
    "build": "node scripts/copy-globe-assets.mjs && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "test": "vitest run",

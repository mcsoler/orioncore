---
// TODO: Replace with real client testimonials and data before publishing
const testimonials = [
  {
    quote: "Orion Core nos ayudó a automatizar procesos que antes consumían gran parte de nuestro tiempo operativo.",
    name: "Cliente 01",
    initials: "C1",
    role: "Director de Operaciones",
    company: "Empresa de referencia",
  },
  {
    quote: "La implementación del agente de IA mejoró nuestra capacidad de respuesta y el seguimiento de nuevas oportunidades.",
    name: "Cliente 02",
    initials: "C2",
    role: "Gerente Comercial",
    company: "Empresa de referencia",
  },
  {
    quote: "Ahora contamos con una estrategia digital más ordenada, medible y enfocada en resultados.",
    name: "Cliente 03",
    initials: "C3",
    role: "CEO",
    company: "Empresa de referencia",
  },
];
---

<section id="testimonios" class="py-24 bg-white">
  <div class="max-w-[1280px] mx-auto px-6 lg:px-8">

    <!-- Header -->
    <div class="text-center mb-16">
      <p class="text-xs font-semibold tracking-[0.2em] uppercase mb-4" style="color: #08CBEF;">
        TESTIMONIOS
      </p>
      <h2 class="text-4xl md:text-5xl font-bold" style="color: #101B31;">
        Lo que dicen nuestros clientes
      </h2>
    </div>

    <!-- Cards grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 lg:gap-8">
      {testimonials.map((t) => (
        <div class="bg-white rounded-2xl p-8 shadow-sm border border-gray-100 flex flex-col transition-all duration-300 hover:shadow-md hover:-translate-y-1 hover:border-blue-200">

          <!-- Quote icon -->
          <div class="mb-6">
            <svg width="36" height="28" viewBox="0 0 36 28" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M0 28V17.6C0 14.1333 0.666667 11.1333 2 8.6C3.33333 6.06667 5.2 3.93333 7.6 2.2C10 0.466667 12.8 -0.266667 16 0.0666667L16 4.4C13.7333 4.93333 11.8 6.06667 10.2 7.8C8.6 9.53333 7.86667 11.4667 8 13.6H14.4V28H0ZM21.6 28V17.6C21.6 14.1333 22.2667 11.1333 23.6 8.6C24.9333 6.06667 26.8 3.93333 29.2 2.2C31.6 0.466667 34.4 -0.266667 37.6 0.0666667L37.6 4.4C35.3333 4.93333 33.4 6.06667 31.8 7.8C30.2 9.53333 29.4667 11.4667 29.6 13.6H36V28H21.6Z" fill="#08CBEF" fill-opacity="0.25"/>
            </svg>
          </div>

          <!-- Quote text -->
          <p class="text-base leading-relaxed italic flex-1 mb-8" style="color: #101B31;">
            "{t.quote}"
          </p>

          <!-- Stars -->
          <div class="flex gap-1 mb-6">
            {[1,2,3,4,5].map(() => (
              <svg width="16" height="16" viewBox="0 0 16 16" fill="#FBBF24" xmlns="http://www.w3.org/2000/svg">
                <path d="M8 1l1.85 3.75L14 5.35l-3 2.92.7 4.12L8 10.27 4.3 12.39l.7-4.12L2 5.35l4.15-.6L8 1z"/>
              </svg>
            ))}
          </div>

          <!-- Author -->
          <div class="flex items-center gap-4">
            <!-- Avatar placeholder -->
            <div
              class="w-10 h-10 rounded-full flex items-center justify-center shrink-0 text-white text-sm font-bold"
              style="background: linear-gradient(135deg, #08CBEF, #2463EB);"
            >
              {t.initials}
            </div>

            <div>
              <p class="text-sm font-semibold" style="color: #101B31;">{t.name}</p>
              <p class="text-xs" style="color: #65748D;">{t.role} — {t.company}</p>
            </div>
          </div>

        </div>
      ))}
    </div>

  </div>
</section>

<style>
  @media (prefers-reduced-motion: reduce) {
    * { transition: none !important; animation: none !important; }
  }
</style>

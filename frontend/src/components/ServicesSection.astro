---
const services = [
  {
    title: "Automatización de Procesos",
    description: "Transformamos tareas manuales y repetitivas en flujos automatizados, más rápidos, medibles y eficientes.",
    capabilities: [
      "Automatización de tareas administrativas",
      "Integración entre plataformas",
      "Reportes y alertas en tiempo real",
    ],
    cta: "Quiero automatizar procesos",
    icon: "gear",
  },
  {
    title: "Agentes de IA para WhatsApp",
    description: "Automatiza la atención, calificación de prospectos y seguimiento comercial mediante agentes conversacionales disponibles 24/7.",
    capabilities: [
      "Respuestas automáticas inteligentes",
      "Calificación y derivación de prospectos",
      "Integración con CRM, agenda o inventario",
    ],
    cta: "Conocer agentes de IA",
    icon: "chat",
  },
  {
    title: "Software Empresarial a Medida",
    description: "Creamos plataformas digitales adaptadas a tus procesos, objetivos y necesidades operativas.",
    capabilities: [
      "CRM y sistemas de gestión",
      "Dashboards y portales empresariales",
      "Aplicaciones e integraciones personalizadas",
    ],
    cta: "Cotizar mi software",
    icon: "code",
  },
  {
    title: "Seguridad y Control de Acceso",
    description: "Implementamos soluciones tecnológicas para proteger instalaciones, información y accesos empresariales.",
    capabilities: [
      "Control de ingreso y permisos",
      "Reconocimiento facial",
      "Registro, monitoreo y alertas",
    ],
    cta: "Evaluar mi seguridad",
    icon: "shield",
  },
  {
    title: "Marketing Digital 360°",
    description: "Diseñamos y ejecutamos estrategias digitales enfocadas en atraer clientes, aumentar las conversiones y fortalecer tu marca.",
    capabilities: [
      "Gestión de pauta en Meta Ads y Google Ads",
      "Diseño de anuncios y piezas publicitarias",
      "Estrategia de contenido y comunicación digital",
      "Creación y optimización de landing pages",
      "Automatización de email marketing",
      "Analítica, seguimiento y optimización de campañas",
    ],
    cta: "Impulsar mi negocio",
    icon: "rocket",
    wideCapabilities: true,
  },
];
---

<section id="servicios" class="py-24 bg-white">
  <div class="max-w-[1280px] mx-auto px-6 lg:px-8">

    <!-- Header -->
    <div class="text-center mb-16">
      <p class="text-xs font-semibold tracking-[0.2em] uppercase mb-4" style="color: #08CBEF;">
        SOLUCIONES QUE IMPULSAN TU CRECIMIENTO
      </p>
      <h2 class="text-4xl md:text-5xl font-bold mb-6" style="color: #101B31;">
        Nuestros <span style="background: linear-gradient(135deg, #08CBEF, #2463EB); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;">Servicios</span>
      </h2>
      <p class="text-lg max-w-2xl mx-auto leading-relaxed" style="color: #65748D;">
        Tecnología, automatización y marketing digital diseñados para resolver los desafíos de tu empresa y acelerar su crecimiento.
      </p>
    </div>

    <!-- Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8 mb-10">

      <!-- Cards 1, 2, 3 -->
      {services.slice(0, 3).map((service) => (
        <div class="service-card group bg-white rounded-2xl p-8 border border-gray-100 shadow-sm transition-all duration-300 hover:shadow-md hover:border-blue-200 hover:-translate-y-1 flex flex-col">
          <!-- Icon -->
          <div class="mb-6" style="background: linear-gradient(135deg, rgba(8,203,239,0.12), rgba(36,99,235,0.12)); border-radius: 12px; width:48px; height:48px; display:flex; align-items:center; justify-content:center;">
            {service.icon === "gear" && (
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#2463EB" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="3"/>
                <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/>
              </svg>
            )}
            {service.icon === "chat" && (
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#2463EB" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
                <line x1="9" y1="10" x2="9" y2="10"/>
                <line x1="12" y1="10" x2="12" y2="10"/>
                <line x1="15" y1="10" x2="15" y2="10"/>
              </svg>
            )}
            {service.icon === "code" && (
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#2463EB" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <rect x="2" y="3" width="20" height="14" rx="2" ry="2"/>
                <line x1="8" y1="21" x2="16" y2="21"/>
                <line x1="12" y1="17" x2="12" y2="21"/>
                <polyline points="9 8 5 12 9 16"/>
                <polyline points="15 8 19 12 15 16"/>
              </svg>
            )}
          </div>

          <!-- Title -->
          <h3 class="text-xl font-semibold mb-3" style="color: #101B31;">{service.title}</h3>

          <!-- Description -->
          <p class="text-base leading-relaxed mb-6" style="color: #65748D;">{service.description}</p>

          <!-- Capabilities -->
          <ul class="space-y-2 mb-8 flex-1">
            {service.capabilities.map((cap) => (
              <li class="flex items-start gap-2">
                <svg class="mt-0.5 shrink-0" width="16" height="16" viewBox="0 0 16 16" fill="none">
                  <circle cx="8" cy="8" r="8" fill="#2463EB" fill-opacity="0.1"/>
                  <polyline points="4.5,8.5 7,11 11.5,5.5" stroke="#2463EB" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                <span class="text-sm" style="color: #65748D;">{cap}</span>
              </li>
            ))}
          </ul>

          <!-- CTA -->
          <a href="#contacto" class="inline-flex items-center gap-1 text-sm font-semibold transition-all duration-300" style="color: #2463EB;">
            <span>{service.cta}</span>
            <span class="transition-transform duration-300 group-hover:translate-x-1">→</span>
          </a>
        </div>
      ))}

      <!-- Cards 4 & 5 — centered row spanning all 3 cols on lg -->
      <div class="md:col-span-2 lg:col-span-3 flex flex-col md:flex-row justify-center gap-6 lg:gap-8">

        {services.slice(3).map((service) => (
          <div class="service-card group bg-white rounded-2xl p-8 border border-gray-100 shadow-sm transition-all duration-300 hover:shadow-md hover:border-blue-200 hover:-translate-y-1 flex flex-col w-full md:max-w-[420px] lg:max-w-[400px]">
            <!-- Icon -->
            <div class="mb-6" style="background: linear-gradient(135deg, rgba(8,203,239,0.12), rgba(36,99,235,0.12)); border-radius: 12px; width:48px; height:48px; display:flex; align-items:center; justify-content:center;">
              {service.icon === "shield" && (
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#2463EB" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                  <polyline points="9,12 11,14 15,10" stroke="#2463EB" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              )}
              {service.icon === "rocket" && (
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#2463EB" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09z"/>
                  <path d="M12 15l-3-3a22 22 0 0 1 2-3.95A12.88 12.88 0 0 1 22 2c0 2.72-.78 7.5-6 11a22.35 22.35 0 0 1-4 2z"/>
                  <path d="M9 12H4s.55-3.03 2-4c1.62-1.08 5 0 5 0"/>
                  <path d="M12 15v5s3.03-.55 4-2c1.08-1.62 0-5 0-5"/>
                </svg>
              )}
            </div>

            <!-- Title -->
            <h3 class="text-xl font-semibold mb-3" style="color: #101B31;">{service.title}</h3>

            <!-- Description -->
            <p class="text-base leading-relaxed mb-6" style="color: #65748D;">{service.description}</p>

            <!-- Capabilities — 2-col grid for Marketing card -->
            {service.wideCapabilities ? (
              <ul class="grid grid-cols-2 gap-x-4 gap-y-2 mb-8 flex-1">
                {service.capabilities.map((cap) => (
                  <li class="flex items-start gap-2">
                    <svg class="mt-0.5 shrink-0" width="16" height="16" viewBox="0 0 16 16" fill="none">
                      <circle cx="8" cy="8" r="8" fill="#2463EB" fill-opacity="0.1"/>
                      <polyline points="4.5,8.5 7,11 11.5,5.5" stroke="#2463EB" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                    <span class="text-sm" style="color: #65748D;">{cap}</span>
                  </li>
                ))}
              </ul>
            ) : (
              <ul class="space-y-2 mb-8 flex-1">
                {service.capabilities.map((cap) => (
                  <li class="flex items-start gap-2">
                    <svg class="mt-0.5 shrink-0" width="16" height="16" viewBox="0 0 16 16" fill="none">
                      <circle cx="8" cy="8" r="8" fill="#2463EB" fill-opacity="0.1"/>
                      <polyline points="4.5,8.5 7,11 11.5,5.5" stroke="#2463EB" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                    <span class="text-sm" style="color: #65748D;">{cap}</span>
                  </li>
                ))}
              </ul>
            )}

            <!-- CTA -->
            <a href="#contacto" class="inline-flex items-center gap-1 text-sm font-semibold transition-all duration-300" style="color: #2463EB;">
              <span>{service.cta}</span>
              <span class="transition-transform duration-300 group-hover:translate-x-1">→</span>
            </a>
          </div>
        ))}

      </div>
    </div>

    <!-- Trust Banner -->
    <div class="relative rounded-2xl overflow-hidden p-10" style="background-color: #061126;">
      <!-- SVG dot pattern overlay -->
      <div class="absolute inset-0 opacity-20 pointer-events-none" aria-hidden="true">
        <svg width="100%" height="100%" xmlns="http://www.w3.org/2000/svg">
          <defs>
            <pattern id="dots-services" x="0" y="0" width="24" height="24" patternUnits="userSpaceOnUse">
              <circle cx="2" cy="2" r="1.5" fill="#08CBEF"/>
            </pattern>
          </defs>
          <rect width="100%" height="100%" fill="url(#dots-services)"/>
        </svg>
      </div>

      <div class="relative z-10 flex flex-col md:flex-row items-center justify-between gap-8">
        <!-- Left text -->
        <div class="text-center md:text-left max-w-xl">
          <h3 class="text-2xl font-bold text-white mb-3">
            ¿No sabes qué solución necesita tu empresa?
          </h3>
          <p style="color: rgba(255,255,255,0.7);" class="text-base leading-relaxed">
            Cuéntanos tu desafío y nuestro equipo te ayudará a definir la alternativa adecuada.
          </p>
        </div>

        <!-- Right button -->
        <div class="flex-shrink-0 w-full md:w-auto">
          <a
            href="#contacto"
            class="block md:inline-block text-center font-semibold px-8 py-4 rounded-full transition-all duration-300 hover:shadow-lg hover:scale-105"
            style="background-color: #FFFFFF; color: #061126;"
          >
            Solicitar diagnóstico
          </a>
        </div>
      </div>
    </div>

  </div>
</section>

<style>
  @media (prefers-reduced-motion: reduce) {
    * { transition: none !important; animation: none !important; }
  }
</style>

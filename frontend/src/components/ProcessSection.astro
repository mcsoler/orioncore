---
const steps = [
  {
    number: "01",
    title: "Entendemos tu negocio",
    description: "Analizamos tus procesos, desafíos, objetivos y oportunidades de crecimiento.",
  },
  {
    number: "02",
    title: "Diseñamos la solución",
    description: "Definimos la estrategia, tecnología y alcance más adecuados para tus necesidades.",
  },
  {
    number: "03",
    title: "Desarrollamos e implementamos",
    description: "Construimos, configuramos e integramos la solución de forma ágil y segura.",
  },
  {
    number: "04",
    title: "Medimos y optimizamos",
    description: "Analizamos resultados, implementamos mejoras y escalamos la solución.",
  },
];
---

<section id="proceso" class="py-24" style="background-color: #F6F8FC;">
  <div class="max-w-[1280px] mx-auto px-6 lg:px-8">

    <!-- Header -->
    <div class="text-center mb-16">
      <p class="text-xs font-semibold tracking-[0.2em] uppercase mb-4" style="color: #08CBEF;">
        NUESTRO PROCESO
      </p>
      <h2 class="text-4xl md:text-5xl font-bold" style="color: #101B31;">
        Así trabajamos contigo
      </h2>
    </div>

    <!-- Steps — Desktop: horizontal row | Mobile: vertical stack -->
    <div class="relative">

      <!-- Desktop connecting line -->
      <div class="hidden lg:block absolute top-[52px] left-[calc(12.5%+32px)] right-[calc(12.5%+32px)] h-px z-0" style="background: linear-gradient(to right, #08CBEF, #2463EB);"></div>

      <div class="flex flex-col lg:flex-row gap-0 lg:gap-0 relative">
        {steps.map((step, index) => (
          <div class="relative flex lg:flex-col items-start lg:items-center gap-6 lg:gap-0 lg:flex-1 lg:px-4 group">

            <!-- Mobile vertical line (between steps) -->
            {index < steps.length - 1 && (
              <div class="lg:hidden absolute left-[25px] top-[52px] bottom-[-24px] w-px z-0" style="background: linear-gradient(to bottom, #08CBEF, #2463EB);"></div>
            )}

            <!-- Step number bubble -->
            <div
              class="relative z-10 w-[52px] h-[52px] shrink-0 rounded-full flex items-center justify-center font-bold text-sm transition-transform duration-300 group-hover:scale-110"
              style="background: linear-gradient(135deg, #08CBEF, #2463EB); color: #FFFFFF;"
            >
              {step.number}
            </div>

            <!-- Card -->
            <div class="lg:mt-6 bg-white rounded-2xl p-6 shadow-sm border border-gray-100 transition-all duration-300 hover:shadow-md hover:-translate-y-1 group-hover:border-blue-200 flex-1 lg:flex-none lg:w-full">
              <h3 class="text-lg font-semibold mb-2" style="color: #101B31;">{step.title}</h3>
              <p class="text-sm leading-relaxed" style="color: #65748D;">{step.description}</p>
            </div>

          </div>
        ))}
      </div>

    </div>

  </div>
</section>

<style>
  @media (prefers-reduced-motion: reduce) {
    * { transition: none !important; animation: none !important; }
  }
</style>

<script is:inline src="/globe.gl.min.js"></script>
<script is:inline>
  (function () {
    function initGlobe() {
      var el = document.getElementById('globeViz');
      if (!el || typeof Globe === 'undefined') return;

      var arcsData = [
        { startLat: 40.7,  startLng: -74,   endLat: 51.5,  endLng: -0.1  },
        { startLat: 51.5,  startLng: -0.1,  endLat: 35.7,  endLng: 139.7 },
        { startLat: 35.7,  startLng: 139.7, endLat: -33.9, endLng: 151.2 },
        { startLat: -23.5, startLng: -46.6, endLat: 40.7,  endLng: -74   },
        { startLat: 19.4,  startLng: -99.1, endLat: 48.9,  endLng: 2.3   },
        { startLat: 1.3,   startLng: 103.8, endLat: 55.8,  endLng: 37.6  },
        { startLat: 25.2,  startLng: 55.3,  endLat: 51.5,  endLng: -0.1  },
        { startLat: -33.9, startLng: 151.2, endLat: 19.4,  endLng: -99.1 },
      ];

      var pointsData = arcsData.flatMap(function(a) {
        return [
          { lat: a.startLat, lng: a.startLng },
          { lat: a.endLat,   lng: a.endLng   },
        ];
      });

      var myGlobe = Globe()
        (el)
        .globeImageUrl('/earth/earth-blue-marble.jpg')
        .bumpImageUrl('/earth/earth-topology.png')
        .backgroundColor('rgba(0,0,0,0)')
        .width(600)
        .height(600)
        .atmosphereColor('#00e0ff')
        .atmosphereAltitude(0.38)
        .arcsData(arcsData)
        .arcColor(function() { return ['rgba(0,224,255,0.3)', 'rgba(0,224,255,0.9)']; })
        .arcStroke(0.5)
        .arcDashLength(0.4)
        .arcDashGap(0.2)
        .arcDashAnimateTime(1800)
        .pointsData(pointsData)
        .pointColor(function() { return 'rgba(0,224,255,0.9)'; })
        .pointAltitude(0.015)
        .pointRadius(0.5);

      // Rotación continua: mover la cámara en órbita circular
      // Deshabilitamos los controles y posicionamos la cámara manualmente cada frame
      setTimeout(function() {
        try {
          var ctrl = myGlobe.controls();
          ctrl.enabled   = false; // desactivar interacción del usuario
          ctrl.enableZoom = false;
          ctrl.enablePan  = false;

          var camera = myGlobe.camera();
          var radius = camera.position.length(); // distancia actual al centro
          var angle  = Math.atan2(camera.position.x, camera.position.z);

          (function tick() {
            requestAnimationFrame(tick);
            angle += 0.0015; // ~5°/s a 60fps
            camera.position.x = radius * Math.sin(angle);
            camera.position.z = radius * Math.cos(angle);
            camera.lookAt(0, 0, 0);
          })();
        } catch(e) { console.error('globe-rot:', e); }
      }, 1500);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initGlobe);
    } else {
      initGlobe();
    }
  })();
</script>

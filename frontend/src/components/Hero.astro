    <!--
      ══ CAMPO MAGNÉTICO TERRESTRE ══
      Centro del globo en el SVG ≈ (1140, 450)
      Radio del globo canvas ≈ 280 px en espacio SVG
      Cada elipse simula una línea de campo que rodea la Tierra:
        - Elipses achatadas (ry pequeño) → anillos ecuatoriales (vistos casi de canto)
        - Elipses más altas  (ry mayor)  → líneas de campo de latitudes altas
        - Rotación  para distribuirlos en 3D
    -->
    <g fill="none" stroke="#00e0ff" stroke-linecap="round">

      <!-- Anillo ecuatorial 1 — plano, envuelve el ecuador -->
      <ellipse class="mag" cx="1140" cy="450" rx="308" ry="64"
               stroke-width="1.1" stroke-opacity="0.30"/>

      <!-- Anillo ecuatorial 2 — ligeramente más grande -->
      <ellipse class="mag2" cx="1140" cy="450" rx="390" ry="82"
               stroke-width="0.85" stroke-opacity="0.18"/>

      <!-- Campo medio inclinado −40° (latitudes medias norte/sur) -->
      <ellipse class="mag3" cx="1140" cy="450" rx="330" ry="195"
               stroke-width="1" stroke-opacity="0.22"
               transform="rotate(-40, 1140, 450)"/>

      <!-- Campo medio inclinado +40° (simétrico) -->
      <ellipse class="mag3" cx="1140" cy="450" rx="330" ry="195"
               stroke-width="1" stroke-opacity="0.22"
               transform="rotate(40, 1140, 450)"/>

      <!-- Alta latitud −68° (líneas de campo polar) -->
      <ellipse class="mag4" cx="1140" cy="450" rx="360" ry="288"
               stroke-width="0.85" stroke-opacity="0.16"
               transform="rotate(-68, 1140, 450)"/>

      <!-- Alta latitud +68° -->
      <ellipse class="mag4" cx="1140" cy="450" rx="360" ry="288"
               stroke-width="0.85" stroke-opacity="0.16"
               transform="rotate(68, 1140, 450)"/>

      <!-- Casi polar −85° (pasa cerca de los polos) -->
      <ellipse class="mag5" cx="1140" cy="450" rx="295" ry="290"
               stroke-width="0.75" stroke-opacity="0.12"
               transform="rotate(-85, 1140, 450)"/>

      <!-- Casi polar +85° -->
      <ellipse class="mag5" cx="1140" cy="450" rx="295" ry="290"
               stroke-width="0.75" stroke-opacity="0.12"
               transform="rotate(85, 1140, 450)"/>

      <!-- Campo lejano ecuatorial (magnetosfera exterior) -->
      <ellipse class="mag2" cx="1140" cy="450" rx="435" ry="98"
               stroke-width="0.7" stroke-opacity="0.11"/>


<style>
  /* ── GLOBO ── */
  #globeViz {
    position: absolute;
    right: -20px;
    top: 50%;
    transform: translateY(-50%);
    width: 600px;
    height: 600px;
    opacity: 0.92;
    pointer-events: none;
    z-index: 1;
    /* brightness eleva océanos oscuros, contrast los suaviza */
    filter: brightness(1.6) contrast(0.78) saturate(1.05) opacity(0.55)
            drop-shadow(0 0 28px rgba(0, 224, 255, 0.25))
            drop-shadow(0 0 60px rgba(0, 224, 255, 0.10));
  }
  #globeViz canvas { display: block; }

  /* ── CAMPO MAGNÉTICO (anillos SVG) ── */
  @keyframes ringPulse {
    0%, 100% { opacity: 0.55; }
    50%       { opacity: 1;    }
  }
  .mag { animation: ringPulse 4s ease-in-out infinite; }
  .mag2 { animation: ringPulse 4.5s ease-in-out infinite 0.8s; }
  .mag3 { animation: ringPulse 5s ease-in-out infinite 1.6s; }
  .mag4 { animation: ringPulse 5.5s ease-in-out infinite 2.4s; }
  .mag5 { animation: ringPulse 6s ease-in-out infinite 3.2s; }

  .svg-overlay { z-index: 2; }

  /* ── NODOS ── */
  @keyframes hubFlash {
    0%, 80%, 100% { opacity: 0.45; }
    85%            { opacity: 0.9; filter: drop-shadow(0 0 6px #00e0ff); }
  }
  @keyframes hubPulse {
    0%, 100% { r: 5px; }
    50%      { r: 8px; }
  }
  @keyframes smallBlink {
    0%, 100% { opacity: 0.2; }
    50%      { opacity: 0.55; }
  }
  .h1 { animation: hubFlash 3s ease-in-out infinite,         hubPulse 3s ease-in-out infinite;         }
  .h2 { animation: hubFlash 3s ease-in-out infinite 1s,     hubPulse 3s ease-in-out infinite 1s;     }
  .h3 { animation: hubFlash 3s ease-in-out infinite 2s,     hubPulse 3s ease-in-out infinite 2s;     }
  .h4 { animation: hubFlash 2.5s ease-in-out infinite 0.5s, hubPulse 2.5s ease-in-out infinite 0.5s; }
  .h5 { animation: hubFlash 3.5s ease-in-out infinite 1.5s, hubPulse 3.5s ease-in-out infinite 1.5s; }
  .sn  { animation: smallBlink 2s ease-in-out infinite; }
  .sn2 { animation: smallBlink 2s ease-in-out infinite 0.7s; }
  .sn3 { animation: smallBlink 2s ease-in-out infinite 1.4s; }

  /* ── LÍNEAS ── */
  @keyframes dataFlow {
    0%   { stroke-dashoffset: 400; opacity: 0.05; }
    50%  { opacity: 0.28; }
    100% { stroke-dashoffset: 0;   opacity: 0.05; }
  }
  .fl  { stroke-dasharray: 400; animation: dataFlow 1.8s linear infinite; }
  .fl2 { stroke-dasharray: 400; animation: dataFlow 1.8s linear infinite 0.6s; }
  .fl3 { stroke-dasharray: 400; animation: dataFlow 1.8s linear infinite 1.2s; }

  /* ── CADENAS ── */
  @keyframes chainFloat {
    0%, 100% { transform: translate(0px,  0px) rotate(0deg);  }
    33%      { transform: translate(6px, -7px) rotate(2deg);  }
    66%      { transform: translate(-5px, 5px) rotate(-2deg); }
  }
  .c1 { animation: chainFloat  9s ease-in-out infinite;    }
  .c2 { animation: chainFloat 11s ease-in-out infinite 2s; }
  .c3 { animation: chainFloat 13s ease-in-out infinite 1s; }

  /* ── VELAS ── */
  @keyframes candleAnim {
    0%, 100% { transform: scaleY(1);   opacity: 0.25; }
    50%      { transform: scaleY(1.1); opacity: 0.4;  }
  }
  .cv1 { animation: candleAnim 4s ease-in-out infinite;    transform-origin: 160px 860px; }
  .cv2 { animation: candleAnim 4s ease-in-out infinite 2s; transform-origin: 1150px 160px; }

  /* ── TENDENCIA ── */
  @keyframes trendDraw {
    0%   { stroke-dashoffset: 1200; opacity: 0.05; }
    40%  { opacity: 0.22; }
    100% { stroke-dashoffset: 0;    opacity: 0.05; }
  }
  .trend { stroke-dasharray: 1200; animation: trendDraw 5s ease-in-out infinite; }

  /* ── TEXTO hero ── */
  .hero-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: 'Inter', sans-serif;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #00e0ff;
    opacity: 0.9;
    margin-bottom: 20px;
  }
  .hero-eyebrow::before {
    content: '';
    display: block;
    width: 28px;
    height: 1px;
    background: #00e0ff;
    opacity: 0.7;
  }
</style>


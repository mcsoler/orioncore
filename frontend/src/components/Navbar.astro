---
const navLinks = [
  { href: "#inicio",        label: "Inicio" },
  { href: "#servicios",     label: "Servicios" },
  { href: "#contacto",      label: "Contáctanos" },
];
---

<nav class="fixed top-0 left-0 right-0 z-50 border-b border-white/5"
     style="background: rgba(2, 8, 30, 0.55); backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px);">
  <div class="max-w-7xl mx-auto px-6 lg:px-8">
    <div class="flex items-center justify-between h-[68px]">

      <!-- Logo: isotipo + nombre -->
      <a href="#inicio" class="flex items-center gap-3 group">
        <!-- Isotipo: constelación Orión abstracta -->
        <div class="relative w-9 h-9 shrink-0">
          <svg viewBox="0 0 36 36" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-9 h-9">
            <!-- Nodos principales (patrón Orión) -->
            <circle cx="18"  cy="4"  r="2.8" fill="#00e0ff" opacity="0.95"/>
            <circle cx="9"   cy="13" r="2.2" fill="#00e0ff" opacity="0.85"/>
            <circle cx="27"  cy="13" r="2.2" fill="#00e0ff" opacity="0.85"/>
            <circle cx="14"  cy="20" r="1.8" fill="#00e0ff" opacity="0.75"/>
            <circle cx="22"  cy="20" r="1.8" fill="#00e0ff" opacity="0.75"/>
            <circle cx="9"   cy="29" r="2.2" fill="#00e0ff" opacity="0.9"/>
            <circle cx="27"  cy="29" r="2.2" fill="#00e0ff" opacity="0.9"/>
            <!-- Líneas de conexión -->
            <line x1="18" y1="4"  x2="9"  y2="13" stroke="#00e0ff" stroke-width="0.9" stroke-opacity="0.5"/>
            <line x1="18" y1="4"  x2="27" y2="13" stroke="#00e0ff" stroke-width="0.9" stroke-opacity="0.5"/>
            <line x1="9"  y1="13" x2="27" y2="13" stroke="#00e0ff" stroke-width="0.9" stroke-opacity="0.35"/>
            <line x1="9"  y1="13" x2="14" y2="20" stroke="#00e0ff" stroke-width="0.9" stroke-opacity="0.5"/>
            <line x1="27" y1="13" x2="22" y2="20" stroke="#00e0ff" stroke-width="0.9" stroke-opacity="0.5"/>
            <line x1="14" y1="20" x2="9"  y2="29" stroke="#00e0ff" stroke-width="0.9" stroke-opacity="0.5"/>
            <line x1="22" y1="20" x2="27" y2="29" stroke="#00e0ff" stroke-width="0.9" stroke-opacity="0.5"/>
            <line x1="9"  y1="29" x2="27" y2="29" stroke="#00e0ff" stroke-width="0.9" stroke-opacity="0.35"/>
            <!-- Halo del nodo superior -->
            <circle cx="18" cy="4" r="5.5" stroke="#00e0ff" stroke-width="0.6" stroke-opacity="0.2" fill="none"/>
          </svg>
        </div>

        <div class="leading-tight">
          <span class="block text-white font-poppins text-[15px] font-bold tracking-tight group-hover:text-secondary transition-colors duration-300">
            Orion Core
          </span>
          <span class="block text-secondary/70 font-inter text-[10px] font-medium tracking-widest uppercase">
            Tecnologías
          </span>
        </div>
      </a>

      <!-- Desktop Navigation — alineado a la derecha -->
      <div class="hidden md:flex items-center gap-1">
        {navLinks.map((link) => (
          <a
            href={link.href}
            class="relative px-5 py-2 text-[14px] font-medium text-white/75 hover:text-white
                   transition-colors duration-200 group font-inter tracking-wide"
          >
            {link.label}
            <span class="absolute bottom-0 left-5 right-5 h-px bg-secondary scale-x-0 group-hover:scale-x-100 transition-transform duration-300 origin-left rounded-full"></span>
          </a>
        ))}
        <a href="#contacto"
           class="ml-3 px-5 py-2 border border-secondary/40 text-secondary text-[13px] font-semibold
                  rounded-lg hover:bg-secondary/10 hover:border-secondary hover:shadow-glow-cyan
                  transition-all duration-300 font-inter">
          Hablar con Michael
        </a>
      </div>

      <!-- Mobile Menu Button -->
      <button
        id="mobile-menu-btn"
        class="md:hidden text-white/80 p-2 hover:text-white transition-colors"
        aria-label="Abrir menú"
      >
        <svg id="icon-open"  class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
        </svg>
        <svg id="icon-close" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </button>
    </div>

    <!-- Mobile Navigation -->
    <div id="mobile-menu" class="hidden md:hidden border-t border-white/10 py-3 space-y-1">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class="block px-3 py-2.5 text-[14px] text-white/80 hover:text-white hover:bg-white/5
                 rounded-lg font-medium transition-all duration-200 font-inter"
        >
          {link.label}
        </a>
      ))}
    </div>
  </div>
</nav>

<script>
  const mobileMenuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu    = document.getElementById('mobile-menu');
  const iconOpen      = document.getElementById('icon-open');
  const iconClose     = document.getElementById('icon-close');

  mobileMenuBtn?.addEventListener('click', () => {
    const isHidden = mobileMenu?.classList.toggle('hidden');
    iconOpen?.classList.toggle('hidden', !isHidden);
    iconClose?.classList.toggle('hidden', isHidden);
  });

  mobileMenu?.querySelectorAll('a').forEach(link => {
    link.addEventListener('click', () => {
      mobileMenu?.classList.add('hidden');
      iconOpen?.classList.remove('hidden');
      iconClose?.classList.add('hidden');
    });
  });
</script>

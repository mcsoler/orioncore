---
// TODO: Replace with verified real data before publishing
const metrics = [
  { value: "100+", label: "Proyectos completados" },
  { value: "50+",  label: "Clientes satisfechos" },
  { value: "5+",   label: "Años de experiencia" },
  { value: "24/7", label: "Soporte técnico" },
];

const checklist = [
  "Enfoque en resultados medibles",
  "Tecnología escalable y segura",
  "Soluciones adaptadas a cada negocio",
  "Acompañamiento continuo",
  "Equipo multidisciplinario",
];
---

<section id="nosotros" class="py-24 bg-white">
  <div class="max-w-[1280px] mx-auto px-6 lg:px-8">

    <div class="rounded-3xl p-10 lg:p-16" style="background-color: #061126;">
      <div class="flex flex-col lg:flex-row gap-12 lg:gap-16 items-start">

        <!-- Left column -->
        <div class="flex-1">
          <!-- Eyebrow -->
          <p class="text-xs font-semibold tracking-[0.2em] uppercase mb-4" style="color: #08CBEF;">
            ¿QUIÉNES SOMOS?
          </p>

          <!-- Title -->
          <h2 class="text-3xl md:text-4xl font-bold text-white mb-6 leading-tight">
            Innovación, experiencia y{" "}
            <span style="background: linear-gradient(135deg, #08CBEF, #2463EB); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;">
              compromiso
            </span>
          </h2>

          <!-- Body text -->
          <p class="text-base leading-relaxed mb-8" style="color: rgba(255,255,255,0.7);">
            En Orion Core Tecnologías combinamos estrategia, desarrollo, inteligencia artificial y marketing digital para crear soluciones que generan impacto real en las empresas.
          </p>

          <!-- Checklist -->
          <ul class="space-y-3 mb-10">
            {checklist.map((item) => (
              <li class="flex items-center gap-3">
                <div class="shrink-0 w-6 h-6 rounded-full flex items-center justify-center" style="background-color: #2463EB;">
                  <svg width="12" height="12" viewBox="0 0 12 12" fill="none">
                    <polyline points="2,6.5 5,9.5 10,3.5" stroke="white" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </div>
                <span class="text-sm font-medium" style="color: rgba(255,255,255,0.9);">{item}</span>
              </li>
            ))}
          </ul>

          <!-- Button -->
          <a
            href="#nosotros"
            class="inline-block font-semibold px-7 py-3.5 rounded-full transition-all duration-300 hover:opacity-90 hover:scale-105"
            style="background-color: #2463EB; color: #FFFFFF;"
          >
            Conocer más sobre nosotros
          </a>
        </div>

        <!-- Right column — Metrics -->
        <div class="w-full lg:w-auto lg:min-w-[340px]">
          <div class="grid grid-cols-2 gap-4">
            {metrics.map((metric) => (
              <div
                class="rounded-2xl p-6 flex flex-col items-center text-center"
                style="background-color: rgba(255,255,255,0.08);"
              >
                <span
                  class="text-4xl font-bold mb-2 block"
                  style="background: linear-gradient(135deg, #08CBEF, #2463EB); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;"
                >
                  {metric.value}
                </span>
                <span class="text-sm leading-snug" style="color: rgba(255,255,255,0.65);">
                  {metric.label}
                </span>
              </div>
            ))}
          </div>
        </div>

      </div>
    </div>

  </div>
</section>

<style>
  @media (prefers-reduced-motion: reduce) {
    * { transition: none !important; animation: none !important; }
  }
</style>

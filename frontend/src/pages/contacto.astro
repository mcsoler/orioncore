---
import { container } from '../composition/container';
import ContactSection from '../ui/components/home/ContactSection.astro';
import DraftPageLayout from '../ui/layouts/DraftPageLayout.astro';

const app = container();
const view = await app.getHomeContent.execute();
---

<DraftPageLayout path="/contacto/" cta={{ label: 'Ir al formulario', href: '#contacto' }}>
  <ContactSection
    contact={view.contact}
    services={view.services.items}
    whatsappHref={app.whatsappLink(view.business.whatsapp, view.contact.whatsappMessage)}
  />
</DraftPageLayout>

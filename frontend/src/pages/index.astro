---
import { container } from '../composition/container';
import BaseLayout from '../ui/layouts/BaseLayout.astro';
import Hero from '../ui/components/home/Hero.astro';
import ClientLogos from '../ui/components/home/ClientLogos.astro';
import PainPoints from '../ui/components/home/PainPoints.astro';
import Services from '../ui/components/home/Services.astro';
import Marketing360 from '../ui/components/home/Marketing360.astro';
import LossCalculatorSection from '../ui/components/home/LossCalculatorSection.astro';
import Results from '../ui/components/home/Results.astro';
import Process from '../ui/components/home/Process.astro';
import Shop from '../ui/components/home/Shop.astro';
import BlogGuides from '../ui/components/home/BlogGuides.astro';
import Faq from '../ui/components/home/Faq.astro';
import ContactSection from '../ui/components/home/ContactSection.astro';

const app = container();
const view = await app.getHomeContent.execute();
const whatsappHref = app.whatsappLink(view.business.whatsapp, view.contact.whatsappMessage);
---

<BaseLayout seo={app.seoFor('/', app.homeJsonLd(view))} announcement={view.announcement}>
  <Hero hero={view.hero} />
  {/* Oculto hasta tener logos reales de clientes. Para mostrarlo, quitar el comentario. */}
  {/* <ClientLogos {...view.clients} /> */}
  <PainPoints {...view.pains} />
  <Services {...view.services} whatsappHref={whatsappHref} />
  <Marketing360 {...view.marketing} />
  <LossCalculatorSection {...view.calculator} />
  <Results {...view.results} />
  <Process {...view.process} />
  <Shop {...view.shop} />
  <BlogGuides {...view.blog} />
  <Faq {...view.faq} />
  <ContactSection contact={view.contact} whatsappHref={whatsappHref} />
</BaseLayout>

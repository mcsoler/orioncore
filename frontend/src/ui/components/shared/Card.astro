---
interface Props {
  title: string;
  href?: string;
  headingLevel?: 2 | 3 | 4;
  tone?: 'light' | 'dark';
  class?: string;
}

const { title, href, headingLevel = 3, tone = 'light', class: className = '' } = Astro.props;
const Heading = `h${headingLevel}` as 'h2' | 'h3' | 'h4';
const Wrapper = href ? 'a' : 'div';
const isDark = tone === 'dark';
---

<Wrapper
  href={href}
  class:list={[
    'group flex flex-col h-full rounded-2xl border p-6 transition-all duration-300',
    isDark
      ? 'bg-white/5 border-white/10 hover:border-secondary/50'
      : 'bg-white border-ink/10 hover:border-brand-blue/40 hover:shadow-glow-blue',
    href && 'focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-blue',
    className,
  ]}
>
  <slot name="top" />
  <Heading class:list={['text-lg font-semibold font-poppins mb-2', isDark ? 'text-white' : 'text-ink']}>{title}</Heading>
  <div class:list={['text-sm leading-relaxed flex-1', isDark ? 'text-white/75' : 'text-muted']}>
    <slot />
  </div>
  <slot name="bottom" />
</Wrapper>

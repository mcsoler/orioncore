---
/**
 * Sección del home: alterna fondos oscuros (navy / degradado del hero) y claros
 * (bg-main / surface-soft) como en el sitio original.
 */
interface Props {
  id: string;
  title: string;
  tone?: 'dark' | 'light' | 'soft';
  eyebrow?: string;
  subtitle?: string;
  align?: 'center' | 'left';
  class?: string;
}

const { id, title, tone = 'light', eyebrow, subtitle, align = 'center', class: className = '' } = Astro.props;
const headingId = `${id}-titulo`;
const isDark = tone === 'dark';

const background = { dark: 'bg-navy', light: 'bg-bg-main', soft: 'bg-surface-soft' }[tone];
---

<section id={id} aria-labelledby={headingId} class:list={['py-20 md:py-24 scroll-mt-28', background, className]}>
  <div class="max-w-[1280px] mx-auto px-6 lg:px-8">
    <header class:list={['mb-12 md:mb-16', align === 'center' && 'text-center max-w-3xl mx-auto']}>
      {
        eyebrow && (
          <p class:list={['text-xs font-semibold tracking-[0.2em] uppercase mb-4', isDark ? 'text-brand-cyan' : 'text-brand-blue']}>
            {eyebrow}
          </p>
        )
      }
      <h2
        id={headingId}
        class:list={['text-3xl md:text-5xl font-bold mb-5 font-poppins', isDark ? 'text-white' : 'text-ink']}
      >
        {title}
      </h2>
      {
        subtitle && (
          <p class:list={['text-lg leading-relaxed', isDark ? 'text-white/75' : 'text-muted']}>{subtitle}</p>
        )
      }
    </header>
    <slot />
  </div>
</section>

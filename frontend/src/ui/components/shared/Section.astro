---
/** Sección del home con el encabezado de la referencia (eyebrow + h2 + subtítulo). */
interface Props {
  id: string;
  title: string;
  /** base = navy, surface = superficie (se alternan como en la referencia). */
  tone?: 'base' | 'surface';
  eyebrow?: string;
  subtitle?: string;
  align?: 'center' | 'left';
  class?: string;
}

const { id, title, tone = 'base', eyebrow, subtitle, align = 'center', class: className = '' } = Astro.props;
const headingId = `${id}-titulo`;
---

<section id={id} aria-labelledby={headingId} class:list={['py-[88px] scroll-mt-20', tone === 'surface' ? 'bg-surface' : 'bg-navy', className]}>
  <div class="wrap">
    <header class:list={['mb-9', align === 'center' ? 'text-center max-w-[720px] mx-auto' : 'max-w-[720px]']}>
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      <h2 id={headingId} class="h2">{title}</h2>
      {subtitle && <p class="text-[17px] text-white/70">{subtitle}</p>}
    </header>
    <slot />
  </div>
</section>

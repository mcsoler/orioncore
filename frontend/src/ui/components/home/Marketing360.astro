---
import type { HomeViewModel } from '../../../application/dto/HomeViewModel';

type Props = HomeViewModel['marketing'];

const { eyebrow, title, subtitle, hub, cards } = Astro.props;
---

<section id="marketing360" aria-labelledby="marketing360-titulo" class="bg-surface py-[88px] scroll-mt-20">
  <div class="wrap">
    <div class="flex flex-wrap justify-between items-end gap-6 mb-9">
      <header class="max-w-[680px]">
        <p class="eyebrow">{eyebrow}</p>
        <h2 id="marketing360-titulo" class="h2">{title}</h2>
        <p class="text-[17px] text-white/70">{subtitle}</p>
      </header>
      <a href={hub.href} class="btn-ghost">{hub.label}</a>
    </div>
    <ul class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {
        cards.map((card) => (
          <li>
            <a href={card.href} data-card class="card bg-navy p-[22px] flex flex-col gap-2.5 h-full text-white hover:border-brand-blue transition-colors">
              <span data-number class="w-12 h-12 rounded-xl bg-surface-2 flex items-center justify-center text-brand-cyan font-poppins font-bold">
                {card.number}
              </span>
              <h3 class="font-poppins text-lg leading-tight font-semibold">{card.title}</h3>
              <p class="text-sm leading-normal text-white/70">{card.hook}</p>
              <p class="text-[13px] text-white/70">{card.items.join(' · ')}</p>
              <span data-more class="mt-auto text-sm font-semibold text-brand-cyan">Ver servicio →</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

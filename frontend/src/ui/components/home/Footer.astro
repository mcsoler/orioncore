---
import type { HomeViewModel } from '../../../application/dto/HomeViewModel';
import type { FooterGroup } from '../../../domain/routing/RouteRegistry';
import Logo from '../shared/Logo.astro';

interface Props {
  groups: FooterGroup[];
  business: HomeViewModel['business'];
  whatsappHref?: string;
}

const { groups, business, whatsappHref } = Astro.props;
const year = new Date().getFullYear();
const tel = business.whatsapp ? `tel:+${business.whatsapp}` : undefined;
---

<footer class="bg-hero-from text-white/75 text-sm pb-24 lg:pb-0">
  <div class="max-w-7xl mx-auto px-6 lg:px-8 py-16 grid gap-12 lg:grid-cols-[1.2fr_repeat(4,1fr)]">
    <div class="space-y-5">
      <a href="/" aria-label="Orion Core Tecnologías, inicio" class="inline-block">
        <Logo tone="dark" />
      </a>
      <p class="leading-relaxed max-w-xs">
        Automatización, inteligencia artificial y marketing digital para empresas en Colombia.
      </p>
      <address class="not-italic space-y-2">
        <p class="font-semibold text-white">{business.name}</p>
        <p>{business.address}, {business.city}, Colombia</p>
        {tel && (
          <p>
            <a href={tel} class="hover:text-white">{business.phoneLabel}</a>
          </p>
        )}
        {whatsappHref && (
          <p>
            <a href={whatsappHref} target="_blank" rel="noopener noreferrer" class="hover:text-white">
              WhatsApp
            </a>
          </p>
        )}
        <p>
          <a href={`mailto:${business.email}`} class="hover:text-white break-all">{business.email}</a>
        </p>
        {business.googleBusinessUrl && (
          <p>
            <a href={business.googleBusinessUrl} target="_blank" rel="noopener noreferrer" class="hover:text-white">
              Ver en Google Business
            </a>
          </p>
        )}
      </address>
    </div>

    {
      groups.map((group) => (
        <div>
          <h2 class="text-xs font-semibold tracking-[0.2em] uppercase text-white mb-4">{group.title}</h2>
          <ul class="space-y-2.5">
            {group.links.map((link) => (
              <li>
                <a href={link.href} class="hover:text-white transition-colors">
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
  <div class="border-t border-white/10">
    <p class="max-w-7xl mx-auto px-6 lg:px-8 py-6 text-xs">
      © {year} {business.name}. Todos los derechos reservados.
    </p>
  </div>
</footer>

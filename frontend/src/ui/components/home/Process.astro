---
import type { HomeViewModel } from '../../../application/dto/HomeViewModel';
import Icon from '../shared/Icon.astro';
import Section from '../shared/Section.astro';

type Props = HomeViewModel['process'];

const { title, steps, guarantee } = Astro.props;
---

<Section id="proceso" tone="light" eyebrow="Cómo trabajamos" title={title}>
  <ol class="grid gap-6 md:grid-cols-2 lg:grid-cols-4">
    {
      steps.map((step) => (
        <li class="relative rounded-2xl border border-ink/10 bg-white p-6">
          <span class="font-poppins text-4xl font-extrabold gradient-text" aria-hidden="true">
            {String(step.order).padStart(2, '0')}
          </span>
          <h3 class="font-poppins text-lg font-semibold text-ink mt-3 mb-2">{step.title}</h3>
          <p class="text-sm leading-relaxed text-muted">{step.description}</p>
        </li>
      ))
    }
  </ol>
  <div class="mt-10 flex items-start gap-4 rounded-2xl bg-surface-soft border border-success/30 p-6">
    <Icon name="shield" class="w-7 h-7 text-success shrink-0" />
    <p class="text-ink font-medium">{guarantee}</p>
  </div>
</Section>

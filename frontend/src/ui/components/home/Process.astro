---
import type { HomeViewModel } from '../../../application/dto/HomeViewModel';

type Props = HomeViewModel['process'];

const { eyebrow, title, steps, guarantee } = Astro.props;
---

<section id="proceso" aria-labelledby="proceso-titulo" class="bg-navy py-[88px]">
  <div class="wrap">
    <header class="text-center mb-9">
      <p class="eyebrow">{eyebrow}</p>
      <h2 id="proceso-titulo" class="h2">{title}</h2>
    </header>
    <ol class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {
        steps.map((step) => (
          <li class="card p-6 flex flex-col gap-2.5">
            <span data-number class="w-11 h-11 rounded-xl bg-surface-2 text-brand-cyan flex items-center justify-center font-poppins font-bold">
              {step.number}
            </span>
            <h3 class="font-poppins text-[19px] font-semibold">{step.title}</h3>
            <p class="text-[15px] text-white/70">{step.description}</p>
          </li>
        ))
      }
    </ol>
    <div class="card mt-7 p-7 flex flex-wrap items-center gap-6 border-success">
      <svg width="56" height="56" viewBox="0 0 24 24" fill="none" class="stroke-success shrink-0" stroke-width="1.6" aria-hidden="true">
        <path d="M12 3 4 6v6c0 5 3.5 8 8 9 4.5-1 8-4 8-9V6z"></path><path d="m9 12 2 2 4-4"></path>
      </svg>
      <div class="flex-1 min-w-[260px]">
        <p class="font-poppins text-[22px] font-bold">{guarantee.title}</p>
        <p class="mt-1 text-white/70">{guarantee.body}</p>
      </div>
      <a href={guarantee.cta.href} class="btn-primary">{guarantee.cta.label}</a>
    </div>
  </div>
</section>

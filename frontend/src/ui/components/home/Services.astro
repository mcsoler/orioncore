---
import type { HomeViewModel } from '../../../application/dto/HomeViewModel';
import { iconForHref } from '../../presenters/homePresenter';
import Chip from '../shared/Chip.astro';
import Icon from '../shared/Icon.astro';
import Section from '../shared/Section.astro';

type Props = HomeViewModel['services'];

const { title, subtitle, ctaLabel, items } = Astro.props;
---

<Section id="servicios" tone="light" eyebrow="Soluciones que impulsan tu crecimiento" title={title} subtitle={subtitle}>
  <div class="space-y-16 md:space-y-24">
    {
      items.map((service, i) => (
        <article class:list={['grid items-center gap-10 lg:grid-cols-2', i % 2 === 1 && 'lg:[&>*:first-child]:order-2']}>
          <div
            class="relative aspect-[4/3] rounded-3xl bg-gradient-to-br from-navy to-hero-to flex items-center justify-center overflow-hidden"
            aria-hidden="true"
          >
            <span class="absolute w-64 h-64 rounded-full bg-brand-cyan/10 blur-2xl" />
            <span class="relative flex items-center justify-center w-28 h-28 rounded-3xl bg-white/5 border border-white/10 text-secondary shadow-glow-cyan">
              <Icon name={iconForHref(service.href)} class="w-14 h-14" />
            </span>
          </div>
          <div>
            {service.badge && (
              <Chip tone="amber" class="mb-4">
                {service.badge}
              </Chip>
            )}
            <h3 class="font-poppins text-2xl md:text-3xl font-bold text-ink mb-3">{service.title}</h3>
            {service.headline && <p class="text-lg font-semibold text-brand-blue mb-3">{service.headline}</p>}
            <p class="text-muted leading-relaxed mb-6">{service.description}</p>
            <ul class="space-y-2.5 mb-8">
              {service.items.map((item) => (
                <li class="flex items-start gap-3 text-ink">
                  <Icon name="check" class="w-5 h-5 mt-0.5 text-success shrink-0" />
                  {item}
                </li>
              ))}
            </ul>
            <div class="flex flex-wrap items-center gap-4">
              <a href="#contacto" class="btn-primary">
                {service.cta ?? 'Quiero esta solución'}
              </a>
              <a
                href={service.href}
                aria-label={`Ver detalles de ${service.title}`}
                class="inline-flex items-center gap-1.5 font-semibold text-brand-blue hover:underline underline-offset-4"
              >
                {ctaLabel}
                <Icon name="arrow-right" class="w-4 h-4" />
              </a>
            </div>
          </div>
        </article>
      ))
    }
  </div>
</Section>

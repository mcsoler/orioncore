---
import type { HomeViewModel } from '../../../application/dto/HomeViewModel';
import Icon from '../shared/Icon.astro';
import Section from '../shared/Section.astro';

type Props = HomeViewModel['blog'];

const { title, cta, articles } = Astro.props;
---

<Section id="guias" tone="light" eyebrow="Blog" title={title}>
  <ul class="grid gap-6 md:grid-cols-3">
    {
      articles.map((article) => (
        <li>
          <a href={article.href} class="flex flex-col h-full rounded-2xl border border-ink/10 bg-white p-6 hover:border-brand-blue/40 hover:shadow-glow-blue transition-all">
            <h3 class="font-poppins text-lg font-semibold text-ink mb-2">{article.title}</h3>
            <p class="text-sm text-muted mb-4">{article.description}</p>
            <span class="mt-auto inline-flex items-center gap-1.5 text-sm font-semibold text-brand-blue">
              Leer la guía <Icon name="arrow-right" class="w-4 h-4" />
            </span>
          </a>
        </li>
      ))
    }
  </ul>
  <p class="mt-10 text-center">
    <a href={cta.href} class="btn-ghost">{cta.label}</a>
  </p>
</Section>

---
import type { HomeViewModel } from '../../../application/dto/HomeViewModel';
import Icon from '../shared/Icon.astro';
import Section from '../shared/Section.astro';

type Props = HomeViewModel['faq'];

const { title, items } = Astro.props;
---

<Section id="preguntas" tone="soft" eyebrow="Preguntas frecuentes" title={title}>
  <div class="max-w-3xl mx-auto space-y-3">
    {
      items.map((item) => (
        <details class="group rounded-2xl bg-white border border-ink/10 px-6 py-4 open:shadow-glow-blue">
          <summary class="flex items-center justify-between gap-4 cursor-pointer list-none font-poppins font-semibold text-ink [&::-webkit-details-marker]:hidden">
            {item.question}
            <Icon name="chevron-down" class="w-5 h-5 text-brand-blue shrink-0 transition-transform group-open:rotate-180" />
          </summary>
          <p class="mt-3 text-ink/80 leading-relaxed">{item.answer}</p>
        </details>
      ))
    }
  </div>
</Section>

---
import type { HomeViewModel } from '../../../application/dto/HomeViewModel';
import LeadForm from '../../islands/LeadForm';

interface Props {
  contact: HomeViewModel['contact'];
  whatsappHref?: string;
}

const { contact, whatsappHref } = Astro.props;
---

<section id="contacto" aria-labelledby="contacto-titulo" class="bg-surface py-[88px] scroll-mt-20">
  <div class="wrap grid gap-12 items-start lg:grid-cols-2">
    <div class="flex flex-col gap-[18px]">
      <p class="eyebrow">{contact.eyebrow}</p>
      <h2 id="contacto-titulo" class="h2 my-0">{contact.title}</h2>
      <div class="rounded-[14px] bg-navy border border-line p-[18px]">
        <p class="flex justify-between text-sm">
          <span>{contact.slots.label}</span><strong class="text-amber">{contact.slots.value}</strong>
        </p>
        <div
          role="progressbar"
          aria-label={contact.slots.label}
          aria-valuemin="0"
          aria-valuemax="100"
          aria-valuenow={contact.slots.progress}
          class="h-2 bg-surface-2 rounded-full mt-2.5"
        >
          <div class="h-full bg-amber rounded-full" style={`width:${contact.slots.progress}%`}></div>
        </div>
      </div>
      <ul data-benefits class="flex flex-col gap-3">
        {
          contact.benefits.map((benefit) => (
            <li class="flex gap-2.5 items-start">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" class="stroke-success shrink-0" stroke-width="2.5" aria-hidden="true">
                <path d="m5 12 5 5 9-10" />
              </svg>
              {benefit}
            </li>
          ))
        }
      </ul>
      <div class="flex items-center gap-3.5">
        <span class="ph w-[60px] h-[60px] rounded-full shrink-0" role="img" aria-label={contact.photoAlt}>[Foto]</span>
        <p class="text-[15px]">
          <strong>{contact.person.name}</strong> · {contact.person.role}<br />
          <span class="text-white/70">{contact.person.note}</span>
        </p>
      </div>
      {
        whatsappHref && (
          <a href={whatsappHref} target="_blank" rel="noopener noreferrer" class="btn-whatsapp self-start">
            {contact.whatsappCta}
          </a>
        )
      }
    </div>
    <LeadForm client:visible options={contact.formOptions} privacyHref="/privacidad/" />
  </div>
</section>

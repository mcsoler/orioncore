---
import type { HomeViewModel } from '../../../application/dto/HomeViewModel';
import { painIcon } from '../../presenters/homePresenter';
import Icon from '../shared/Icon.astro';
import Section from '../shared/Section.astro';

type Props = HomeViewModel['pains'];

const { title, items, closing } = Astro.props;
---

<Section id="dolores" tone="soft" title={title}>
  <ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
    {
      items.map((item, i) => (
        <li class="rounded-2xl bg-white border border-ink/10 p-6">
          <span class="inline-flex items-center justify-center w-11 h-11 rounded-xl bg-brand-blue/10 text-brand-blue mb-4">
            <Icon name={painIcon(i)} class="w-6 h-6" />
          </span>
          <h3 class="font-poppins text-lg font-semibold text-ink mb-2">{item.title}</h3>
          <p class="text-sm leading-relaxed text-ink/80">{item.description}</p>
        </li>
      ))
    }
  </ul>
  <p class="mt-12 text-center text-lg font-semibold text-ink">
    {closing} <a href="#contacto" class="text-brand-blue underline underline-offset-4">Pide tu diagnóstico</a>
  </p>
</Section>

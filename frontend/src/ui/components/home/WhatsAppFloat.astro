---
import Icon from '../shared/Icon.astro';

interface Props {
  /** Sin número confirmado no se muestra. */
  href?: string;
}

const { href } = Astro.props;
---

{
  href && (
    <a
      href={href}
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Escríbenos por WhatsApp"
      class="fixed bottom-5 right-5 z-40 flex items-center justify-center w-14 h-14 rounded-full bg-whatsapp text-navy shadow-lg transition-transform hover:scale-105"
    >
      <Icon name="whatsapp" class="w-7 h-7" />
    </a>
  )
}

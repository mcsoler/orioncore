---
import Icon from '../shared/Icon.astro';

interface Props {
  /** Sin número confirmado no se muestra. */
  href?: string;
}

const { href } = Astro.props;
---

{
  href && (
    <a
      href={href}
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Escríbenos por WhatsApp"
      data-whatsapp-float
      class="fixed bottom-5 right-5 z-40 flex items-center justify-center w-14 h-14 rounded-full bg-whatsapp text-navy shadow-lg transition-all duration-300 hover:scale-105"
    >
      <Icon name="whatsapp" class="w-7 h-7" />
    </a>
  )
}

<script>
  // En el home aparece cuando el hero sale de la vista: el hero ya tiene sus CTA
  // y así el botón no tapa el contenido principal en móvil.
  const button = document.querySelector<HTMLElement>('[data-whatsapp-float]');
  const hero = document.getElementById('inicio');
  if (button && hero) {
    const hide = ['invisible', 'opacity-0', 'translate-y-4'];
    new IntersectionObserver(([entry]) => {
      hide.forEach((c) => button.classList.toggle(c, !!entry?.isIntersecting));
    }).observe(hero);
  }
</script>
